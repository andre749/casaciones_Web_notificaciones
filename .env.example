# Copiar como .env.local para correr la pagina en local (npm run dev). NUNCA subir el .env.local a git.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave de cifrado de la identidad del consultante (la MISMA que en worker/.env y en Netlify)
IDENTIDAD_CLAVE=
# Pagos con Culqi (para probar alertas no hacen falta)
NEXT_PUBLIC_ENABLE_PAYMENTS=false
# NEXT_PUBLIC_CULQI_PUBLIC_KEY=
# CULQI_SECRET_KEY=
# CULQI_WEBHOOK_SECRET=
# NEXT_PUBLIC_API_URL=
