# Copiar como worker/.env en la computadora que ejecuta el worker. NUNCA subir el .env a git.
# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# La MISMA clave que IDENTIDAD_CLAVE en Netlify (32 bytes en base64)
IDENTIDAD_CLAVE=
# Opcionales
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Carpeta del perfil de Chrome (por defecto worker/chrome_perfil)
# CEJ_CHROME_PROFILE=chrome_perfil
# Solo si Chrome no se detecta bien (numero principal, ej. 153)
# CEJ_CHROME_VERSION=
